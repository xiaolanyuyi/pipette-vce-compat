    // 创意工坊预览图（≤1 MB，正方形 512×512 或 1024×1024 都行）
    "previewfile"      "E:\\knowledge base\\pipette-vce-compat\\mod\\preview.png"

    // 0 = 公开，1 = 仅好友，2 = 隐藏
    // 首次上传想先测试：临时改成 "2"，测试完务必改回 "0" —— 每次更新都会按这里的值重设可见性，
    // 否则以后一次更新会把已公开的物品重新变成隐藏。
    "visibility"       "0"

    "title"            "移液枪 × 原版化学扩展 兼容补丁 / Pipette × Vanilla Chem Ext Compat"
