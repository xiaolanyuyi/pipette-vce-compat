    "appid"            "4348910"

    // 0 = 创建新物品；上传成功后 steamcmd 会把新 id 写回这里，之后原样再跑就是“更新”
    "publishedfileid"  "0"

    // 要上传的模组文件夹（manifest.xml 必须在根目录）
